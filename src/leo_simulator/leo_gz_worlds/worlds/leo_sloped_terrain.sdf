<?xml version="1.0"?>
<!--
  Leo Rover — Sloped Terrain World
  Designed for slope traversal and climbing capability testing.

  Layout (80×80m, robot starts at 0,0):
    • Gradual slopes      : 5°, 10°, 15°, 20° inclines
    • Steep ramps         : 25°, 30° challenge slopes
    • Mixed terrain       : Flat, rough, and smooth surfaces
    • Recovery zones      : Flat areas between slopes

  GPS datum: Ankara, Turkey (same as leo_empty.sdf)
-->
<sdf version="1.8">
  <world name="leo_sloped_terrain">

    <!-- ── Physics ─────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Plugins ──────────────────────────────────────────────────── -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system"
            name="ignition::gazebo::systems::NavSat"/>

    <!-- ── GPS datum: Ankara ─────────────────────────────────────────── -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>39.925018</latitude_deg>
      <longitude_deg>32.836956</longitude_deg>
      <elevation>890</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ── Lighting ─────────────────────────────────────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane (base) ──────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <!-- Rocky terrain -->
            <ambient>0.5 0.45 0.35 1</ambient>
            <diffuse>0.6 0.55 0.45 1</diffuse>
            <specular>0.05 0.05 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         SLOPES — Various inclines for testing
         
         Ramp calculation:
           For a box of length L and height H:
           slope_angle = atan(H / L)
           
           5° slope:  H/L = 0.087  → L=10m, H=0.87m
           10° slope: H/L = 0.176  → L=10m, H=1.76m
           15° slope: H/L = 0.268  → L=10m, H=2.68m
           20° slope: H/L = 0.364  → L=10m, H=3.64m
           25° slope: H/L = 0.466  → L=8m,  H=3.73m
           30° slope: H/L = 0.577  → L=6m,  H=3.46m
         ════════════════════════════════════════════════════════════════ -->

    <!-- ── 5° Slope (gentle) — North ────────────────────────────────── -->
    <model name="slope_5deg">
      <static>true</static>
      <pose>0 20 0.435 0 0.087 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>6 10 0.87</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>6 10 0.87</size></box></geometry>
          <material><ambient>0.55 0.5 0.4 1</ambient><diffuse>0.65 0.6 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── 10° Slope — East ─────────────────────────────────────────── -->
    <model name="slope_10deg">
      <static>true</static>
      <pose>20 0 0.88 0 0.176 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>6 10 1.76</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>6 10 1.76</size></box></geometry>
          <material><ambient>0.52 0.48 0.38 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── 15° Slope — South ────────────────────────────────────────── -->
    <model name="slope_15deg">
      <static>true</static>
      <pose>0 -20 1.34 0 -0.268 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>6 10 2.68</size></box></geometry>
          <surface><friction><ode><mu>0.75</mu><mu2>0.75</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>6 10 2.68</size></box></geometry>
          <material><ambient>0.5 0.45 0.35 1</ambient><diffuse>0.6 0.55 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── 20° Slope — West ─────────────────────────────────────────── -->
    <model name="slope_20deg">
      <static>true</static>
      <pose>-20 0 1.82 0 -0.364 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>6 10 3.64</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>6 10 3.64</size></box></geometry>
          <material><ambient>0.48 0.43 0.33 1</ambient><diffuse>0.58 0.53 0.43 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── 25° Slope (steep) — NE ───────────────────────────────────── -->
    <model name="slope_25deg">
      <static>true</static>
      <pose>25 25 1.865 0 0.466 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>5 8 3.73</size></box></geometry>
          <surface><friction><ode><mu>0.65</mu><mu2>0.65</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>5 8 3.73</size></box></geometry>
          <material><ambient>0.45 0.4 0.3 1</ambient><diffuse>0.55 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── 30° Slope (very steep) — SW ──────────────────────────────── -->
    <model name="slope_30deg">
      <static>true</static>
      <pose>-25 -25 1.73 0 -0.577 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>4 6 3.46</size></box></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>4 6 3.46</size></box></geometry>
          <material><ambient>0.42 0.38 0.28 1</ambient><diffuse>0.52 0.48 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         FLAT RECOVERY ZONES — Between slopes
         ════════════════════════════════════════════════════════════════ -->

    <model name="flat_zone_ne">
      <static>true</static>
      <pose>25 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <surface><friction><ode><mu>0.85</mu></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="flat_zone_sw">
      <static>true</static>
      <pose>-25 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <surface><friction><ode><mu>0.85</mu></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         ROUGH TERRAIN PATCHES — Different surface textures
         ════════════════════════════════════════════════════════════════ -->

    <!-- Gravel patch -->
    <model name="gravel_patch">
      <static>true</static>
      <pose>0 10 0.01 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Smooth rock patch -->
    <model name="smooth_rock">
      <static>true</static>
      <pose>0 -10 0.01 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         MARKERS — Navigation waypoints
         ════════════════════════════════════════════════════════════════ -->

    <model name="marker_start">
      <static>true</static>
      <pose>0 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.3 0.9 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="marker_north">
      <static>true</static>
      <pose>0 30 0.1 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.3 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="marker_east">
      <static>true</static>
      <pose>30 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
