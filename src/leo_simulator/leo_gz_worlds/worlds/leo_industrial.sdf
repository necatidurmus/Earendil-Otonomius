<?xml version="1.0"?>
<!--
  Leo Rover — Industrial Facility World
  Designed for SLAM navigation testing in structured indoor environment.

  Layout (60×60m, robot starts at 0,0):
    • Warehouse structure  : Large enclosed building
    • Storage racks        : Multiple rows of industrial shelving
    • Corridors            : Narrow passages between racks
    • Loading dock         : Open area for truck access
    • Office area          : Partitioned rooms

  GPS datum: Ankara, Turkey (same as leo_empty.sdf)
-->
<sdf version="1.8">
  <world name="leo_industrial">

    <!-- ── Physics ─────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Plugins ──────────────────────────────────────────────────── -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system"
            name="ignition::gazebo::systems::NavSat"/>

    <!-- ── GPS datum: Ankara ─────────────────────────────────────────── -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>39.925018</latitude_deg>
      <longitude_deg>32.836956</longitude_deg>
      <elevation>890</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ── Lighting (industrial fluorescent) ────────────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.95 1</diffuse>
      <specular>0.2 0.2 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- ── Ground plane (concrete floor) ────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.85</mu><mu2>0.85</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <!-- Concrete -->
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         WAREHOUSE WALLS — Outer structure
         ════════════════════════════════════════════════════════════════ -->

    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 25 5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>50 0.3 10</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>50 0.3 10</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -25 5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>50 0.3 10</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>50 0.3 10</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>25 0 5 0 0 1.5708</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>50 0.3 10</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>50 0.3 10</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall (with loading dock opening) -->
    <model name="wall_west_north">
      <static>true</static>
      <pose>-25 15 5 0 0 1.5708</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>20 0.3 10</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>20 0.3 10</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west_south">
      <static>true</static>
      <pose>-25 -15 5 0 0 1.5708</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>20 0.3 10</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>20 0.3 10</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         STORAGE RACKS — Industrial shelving units
         ════════════════════════════════════════════════════════════════ -->

    <!-- Rack Row A (x = -15 to -5) -->
    <model name="rack_a1">
      <static>true</static>
      <pose>-15 15 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_a2">
      <static>true</static>
      <pose>-15 5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_a3">
      <static>true</static>
      <pose>-15 -5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_a4">
      <static>true</static>
      <pose>-15 -15 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rack Row B (x = -5 to 5) -->
    <model name="rack_b1">
      <static>true</static>
      <pose>-5 15 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_b2">
      <static>true</static>
      <pose>-5 5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_b3">
      <static>true</static>
      <pose>-5 -5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_b4">
      <static>true</static>
      <pose>-5 -15 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rack Row C (x = 5 to 15) -->
    <model name="rack_c1">
      <static>true</static>
      <pose>5 15 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_c2">
      <static>true</static>
      <pose>5 5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_c3">
      <static>true</static>
      <pose>5 -5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_c4">
      <static>true</static>
      <pose>5 -15 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rack Row D (x = 15 to 20) -->
    <model name="rack_d1">
      <static>true</static>
      <pose>15 15 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_d2">
      <static>true</static>
      <pose>15 5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_d3">
      <static>true</static>
      <pose>15 -5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_d4">
      <static>true</static>
      <pose>15 -15 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1 8 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1 8 5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         OFFICE AREA — Partitioned rooms (NE corner)
         ════════════════════════════════════════════════════════════════ -->

    <!-- Office partition 1 -->
    <model name="office_wall_1">
      <static>true</static>
      <pose>20 22 2.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>6 0.15 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>6 0.15 5</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Office partition 2 -->
    <model name="office_wall_2">
      <static>true</static>
      <pose>17 19 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.15 6 5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.15 6 5</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Office desk -->
    <model name="office_desk">
      <static>true</static>
      <pose>22 22 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.5 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.5 0.8 0.8</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         LOADING DOCK — West side open area
         ════════════════════════════════════════════════════════════════ -->

    <!-- Loading dock platform -->
    <model name="loading_dock">
      <static>true</static>
      <pose>-22 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>6 15 0.6</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>6 15 0.6</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pallets -->
    <model name="pallet_01">
      <static>true</static>
      <pose>-20 8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.2 1.0 0.3</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.2 1.0 0.3</size></box></geometry>
          <material><ambient>0.5 0.35 0.15 1</ambient><diffuse>0.6 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_02">
      <static>true</static>
      <pose>-20 -8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.2 1.0 0.3</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.2 1.0 0.3</size></box></geometry>
          <material><ambient>0.5 0.35 0.15 1</ambient><diffuse>0.6 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         FORKLIFT — Moving obstacle (static for now)
         ════════════════════════════════════════════════════════════════ -->

    <model name="forklift">
      <static>true</static>
      <pose>10 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>2.5 1.2 1.2</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>2.5 1.2 1.2</size></box></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.9 0.7 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         MARKERS — Navigation waypoints
         ════════════════════════════════════════════════════════════════ -->

    <marker name="marker_start">
      <static>true</static>
      <pose>0 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.3 0.9 0.3 1</diffuse></material>
        </visual>
      </link>
    </marker>

  </world>
</sdf>
