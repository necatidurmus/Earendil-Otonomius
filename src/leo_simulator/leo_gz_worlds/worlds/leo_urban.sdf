<?xml version="1.0"?>
<!--
  Leo Rover — Urban/City World
  Designed for GPS navigation testing in structured environment.

  Layout (100×100m, robot starts at 0,0):
    • Buildings          : Various sized blocks forming city blocks
    • Roads              : Paved surfaces with intersections
    • Sidewalks          : Raised platforms along roads
    • Parking lots       : Open areas with parked vehicles
    • Park area          : Central green space with paths

  GPS datum: Ankara, Turkey (same as leo_empty.sdf)
-->
<sdf version="1.8">
  <world name="leo_urban">

    <!-- ── Physics ─────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Plugins ──────────────────────────────────────────────────── -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system"
            name="ignition::gazebo::systems::NavSat"/>

    <!-- ── GPS datum: Ankara ─────────────────────────────────────────── -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>39.925018</latitude_deg>
      <longitude_deg>32.836956</longitude_deg>
      <elevation>890</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ── Lighting ─────────────────────────────────────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane (asphalt) ───────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <!-- Dark asphalt -->
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         BUILDINGS — City blocks
         ════════════════════════════════════════════════════════════════ -->

    <!-- Block A — NW corner -->
    <model name="building_a1">
      <static>true</static>
      <pose>-20 20 5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>15 10 10</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>15 10 10</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_a2">
      <static>true</static>
      <pose>-20 35 3 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>10 8 6</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>10 8 6</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Block B — NE corner -->
    <model name="building_b1">
      <static>true</static>
      <pose>20 20 7.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>12 15 15</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>12 15 15</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_b2">
      <static>true</static>
      <pose>35 25 4 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 10 8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>8 10 8</size></box></geometry>
          <material><ambient>0.6 0.58 0.55 1</ambient><diffuse>0.7 0.68 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Block C — SW corner -->
    <model name="building_c1">
      <static>true</static>
      <pose>-20 -20 6 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>18 12 12</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>18 12 12</size></box></geometry>
          <material><ambient>0.58 0.55 0.52 1</ambient><diffuse>0.68 0.65 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_c2">
      <static>true</static>
      <pose>-25 -35 4 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>10 10 8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>10 10 8</size></box></geometry>
          <material><ambient>0.55 0.58 0.6 1</ambient><diffuse>0.65 0.68 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Block D — SE corner -->
    <model name="building_d1">
      <static>true</static>
      <pose>20 -20 8 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>14 14 16</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>14 14 16</size></box></geometry>
          <material><ambient>0.52 0.55 0.58 1</ambient><diffuse>0.62 0.65 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_d2">
      <static>true</static>
      <pose>35 -30 3.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 8 7</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>8 8 7</size></box></geometry>
          <material><ambient>0.6 0.58 0.55 1</ambient><diffuse>0.7 0.68 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         ROAD MARKINGS — Lane dividers (visual only)
         ════════════════════════════════════════════════════════════════ -->

    <!-- Main road N-S (x=0) -->
    <model name="road_ns_center">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>0.3 80</size></plane></geometry>
          <material><ambient>0.9 0.9 0.1 1</ambient><diffuse>1.0 1.0 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Main road E-W (y=0) -->
    <model name="road_ew_center">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>80 0.3</size></plane></geometry>
          <material><ambient>0.9 0.9 0.1 1</ambient><diffuse>1.0 1.0 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         SIDEWALKS — Raised platforms along roads
         ════════════════════════════════════════════════════════════════ -->

    <!-- North sidewalk (along y=10) -->
    <model name="sidewalk_north">
      <static>true</static>
      <pose>0 10 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>60 2 0.2</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>60 2 0.2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South sidewalk (along y=-10) -->
    <model name="sidewalk_south">
      <static>true</static>
      <pose>0 -10 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>60 2 0.2</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>60 2 0.2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East sidewalk (along x=10) -->
    <model name="sidewalk_east">
      <static>true</static>
      <pose>10 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>2 60 0.2</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>2 60 0.2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West sidewalk (along x=-10) -->
    <model name="sidewalk_west">
      <static>true</static>
      <pose>-10 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>2 60 0.2</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>2 60 0.2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         PARK AREA — Central green space
         ════════════════════════════════════════════════════════════════ -->

    <model name="park_grass">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <surface><friction><ode><mu>0.6</mu></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material><ambient>0.3 0.5 0.2 1</ambient><diffuse>0.4 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Park fountain -->
    <model name="fountain">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>1.5</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>1.5</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.6 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Park benches -->
    <model name="bench_01">
      <static>true</static>
      <pose>4 4 0.3 0 0 0.785</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.5 0.5 0.6</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bench_02">
      <static>true</static>
      <pose>-4 -4 0.3 0 0 -0.785</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.5 0.5 0.6</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         PARKING LOT — South area
         ════════════════════════════════════════════════════════════════ -->

    <model name="parking_lot">
      <static>true</static>
      <pose>0 -25 0.01 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>20 10</size></plane></geometry>
          <surface><friction><ode><mu>0.85</mu></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 10</size></plane></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parked cars -->
    <model name="car_01">
      <static>true</static>
      <pose>-6 -25 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>4 2 1.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>4 2 1.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.6 1</ambient><diffuse>0.3 0.3 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="car_02">
      <static>true</static>
      <pose>0 -25 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>4 2 1.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>4 2 1.5</size></box></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.7 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="car_03">
      <static>true</static>
      <pose>6 -25 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>4 2 1.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>4 2 1.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.2 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         TRAFFIC ELEMENTS — Visual landmarks
         ════════════════════════════════════════════════════════════════ -->

    <!-- Traffic light at intersection -->
    <model name="traffic_light_01">
      <static>true</static>
      <pose>5 5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.1</radius><length>5.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.1</radius><length>5.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
      <link name="head">
        <pose>0 0 2.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.3 0.1 0.8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.3 0.1 0.8</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="traffic_light_02">
      <static>true</static>
      <pose>-5 -5 2.5 0 0 3.14</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.1</radius><length>5.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.1</radius><length>5.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
      <link name="head">
        <pose>0 0 2.0 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.3 0.1 0.8</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.3 0.1 0.8</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
