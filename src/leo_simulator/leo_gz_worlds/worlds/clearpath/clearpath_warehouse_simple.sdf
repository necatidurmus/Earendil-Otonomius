<?xml version="1.0" encoding="UTF-8"?>
<!--
  Leo Rover — Warehouse Test World (Simplified)
  Basitleştirilmiş depo ortamı - Fuel indirme gerektirmez
  GPS datum: Ankara, Turkey (39.925018N, 32.836956E, 890m)
-->
<sdf version="1.8">
  <world name="leo_warehouse">

    <!-- ── Physics ─────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Plugins ──────────────────────────────────────────────────── -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system"
            name="ignition::gazebo::systems::NavSat"/>

    <!-- ── GPS datum: Ankara ─────────────────────────────────────────── -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>39.925018</latitude_deg>
      <longitude_deg>32.836956</longitude_deg>
      <elevation>890</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ── Lighting ─────────────────────────────────────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane (kum/toprak rengi) ──────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.6 0.5 0.4 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Warehouse Building (ana bina) ───────────────────────────── -->
    <!-- 40x30m bina, duvarlar 0.3m kalınlığında, 4m yükseklik -->
    
    <!-- Kuzey duvarı -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 15 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.3 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 0.3 4</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Güney duvarı -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -15 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.3 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 0.3 4</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Doğu duvarı -->
    <model name="wall_east">
      <static>true</static>
      <pose>20 0 2 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.3 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.3 4</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Batı duvarı -->
    <model name="wall_west">
      <static>true</static>
      <pose>-20 0 2 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.3 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.3 4</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Raflar (shelf rows) ──────────────────────────────────────── -->
    <!-- Raf 1: Kuzeybatı -->
    <model name="shelf_1">
      <static>true</static>
      <pose>-12 8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 1 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 1 3</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Raf 2: Kuzeydoğu -->
    <model name="shelf_2">
      <static>true</static>
      <pose>12 8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 1 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 1 3</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Raf 3: Orta -->
    <model name="shelf_3">
      <static>true</static>
      <pose>0 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 1 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 1 3</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Raf 4: Güneybatı -->
    <model name="shelf_4">
      <static>true</static>
      <pose>-12 -8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 1 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 1 3</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Raf 5: Güneydoğu -->
    <model name="shelf_5">
      <static>true</static>
      <pose>12 -8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 1 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 1 3</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Masalar ──────────────────────────────────────────────────── -->
    <!-- Masa 1: Ofis alanı -->
    <model name="table_1">
      <static>true</static>
      <pose>15 12 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 1 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 1 0.8</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Masa 2: Yemek alanı -->
    <model name="table_2">
      <static>true</static>
      <pose>15 -12 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 1 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 1 0.8</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Sandalyeler ──────────────────────────────────────────────── -->
    <model name="chair_1">
      <static>true</static>
      <pose>16 12 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="chair_2">
      <static>true</static>
      <pose>14 12 0.25 0 0 3.14</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Bariyerler (navigation challenge) ────────────────────────── -->
    <model name="barrier_1">
      <static>true</static>
      <pose>-5 5 0.5 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 0.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.5 1</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="barrier_2">
      <static>true</static>
      <pose>-5 -5 0.5 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 0.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.5 1</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Paletler ─────────────────────────────────────────────────── -->
    <model name="pallet_1">
      <static>true</static>
      <pose>-15 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 0.2</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_2">
      <static>true</static>
      <pose>-15 -3 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 0.2</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Kutular (paletlerin üzerinde) ────────────────────────────── -->
    <model name="box_1">
      <static>true</static>
      <pose>-15 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><ambient>0.8 0.6 0.3 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>-15 -3 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><ambient>0.8 0.6 0.3 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Forklift (sabit engel) ───────────────────────────────────── -->
    <model name="forklift">
      <static>true</static>
      <pose>5 10 1 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 2 2</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
