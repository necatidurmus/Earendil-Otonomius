<?xml version="1.0" encoding="UTF-8"?>
<!--
  Clearpath Office World — Adapted for Gazebo Fortress
  Original: https://github.com/clearpathrobotics/clearpath_simulator
  Adapted for Leo Rover (Earendil-Otonomius) by plugin name conversion
  GPS datum: Ankara, Turkey (39.925018N, 32.836956E, 890m)
-->
<sdf version='1.4'>
  <world name='office'>
    <physics type='ode'>
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>1</shadows>
    </scene>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- Origin placed somewhere near Clearpath's office in Waterloo, ON, Canada -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>39.925018</latitude_deg>
      <longitude_deg>32.836956</longitude_deg>
      <elevation>890</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name='office'>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name='office'>
        <collision name='office_collision'>
          <geometry>
            <mesh>
              <uri>
                model://office/office.dae
              </uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='office_visual'>
          <geometry>
            <mesh>
              <uri>
                model://office/office.dae
              </uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='charge_dock'>
      <pose>23 -5 0 0 0 2.356194490192345</pose>
      <static>true</static>
      <link name='charge_dock'>
        <collision name='charge_dock_collision'>
          <geometry>
            <mesh>
              <uri>
                model://accessories/wibotic_tr301.stl
              </uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='charge_dock_visual'>
          <geometry>
            <mesh>
              <uri>
                model://accessories/wibotic_tr301.dae
              </uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
